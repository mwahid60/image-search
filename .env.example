# Bank MAS Image Search - local environment
#
# Copy this file to .env at the repository root:
#   cp .env.example .env
#
# All values below are obvious local-only placeholders. Replace them for
# anything other than a laptop demo and never commit .env or real credentials.
# The stack is bound to 127.0.0.1 by default; change BIND_ADDRESS only if you
# understand the exposure.

COMPOSE_PROJECT_NAME=bank-mas-image-search
BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MinIO object storage
# ---------------------------------------------------------------------------
# Root credentials are used by MinIO, the Java fetcher, and the Python backend.
# MinIO requires a root user of at least 3 characters and a password of at
# least 8 characters.
MINIO_ROOT_USER=bankmas-local-admin
MINIO_ROOT_PASSWORD=bankmas-local-password-change-me

# One application bucket. Objects are namespaced with the prefixes below.
MINIO_BUCKET=bank-mas-image-search
MINIO_REGION=us-east-1
MINIO_IMAGES_PREFIX=images/bank-mas/
MINIO_JOBS_PREFIX=jobs/bank-mas/

# Java uses a URL with scheme; the Python MinIO SDK expects host:port only.
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_HOST=minio:9000
MINIO_SECURE=false

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# llama.cpp embeddings server (EmbeddingGemma 2)
# ---------------------------------------------------------------------------
# Pinned CPU server image. Changing it requires re-running the embedding smoke
# test and checking that typed multimodal content parts are still supported.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b12429

# Relative paths are resolved from the deploy/ directory by Podman Compose.
# Use an absolute path if you keep the GGUF files elsewhere.
MODELS_DIR=../models
MODEL_FILE=embeddinggemma-2-UD-Q4_K_XL.gguf
MMPROJ_FILE=mmproj-Q8_0.gguf
LLAMA_MODEL_ALIAS=embeddinggemma-2

# CPU-friendly defaults: one sequence, no GPU offload. 8192 tokens leaves room
# for the model's fixed image-token budget. Reduce only after testing images.
LLAMA_CTX_SIZE=8192
LLAMA_BATCH_SIZE=8192
LLAMA_UBATCH_SIZE=8192
LLAMA_THREADS=4
LLAMA_IMAGE_MIN_TOKENS=280
LLAMA_IMAGE_MAX_TOKENS=280
LLAMA_PORT=8080
LLAMA_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Java fetcher
# ---------------------------------------------------------------------------
FETCHER_PORT=8081
# The Java client appends its own API path, so this base must NOT end with /v1.
OPENVERSE_BASE_URL=https://api.openverse.org
# Optional. Leave empty when unauthenticated Openverse access is sufficient.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_PAGE_SIZE=20
OPENVERSE_MAX_PAGES_PER_CLASS=5
OPENVERSE_REQUEST_TIMEOUT=8s
OPENVERSE_MIN_REQUEST_INTERVAL=250ms

FETCHER_HTTP_CONNECT_TIMEOUT=10s
FETCHER_DOWNLOAD_TIMEOUT=20s
FETCHER_DOWNLOAD_MAX_BYTES=8388608
FETCHER_DOWNLOAD_MAX_PIXELS=25000000
FETCHER_SSE_HEARTBEAT_INTERVAL_MS=15000
FETCHER_SSE_TIMEOUT=30m
FETCHER_JOB_WORKER_THREADS=2
FETCHER_JOB_QUEUE_CAPACITY=32
FETCHER_MAX_RETAINED_JOBS=200
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC"

# ---------------------------------------------------------------------------
# Python backend (FastAPI + Milvus Lite)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
JAVA_BASE_URL=http://fetcher:8081
JAVA_EVENTS_PATH=/api/v1/events/fetch
JAVA_HTTP_TIMEOUT_SECONDS=10
SSE_ENABLED=true

# Path inside the backend container. Backed by the milvus-data volume.
# Deliberately not named after the pymilvus remote-URI setting.
MILVUS_DB_PATH=/data/milvus.db
MILVUS_COLLECTION=image_embeddings

# Internal compose address. The smoke-test script defaults to localhost:8080.
LLAMA_BASE_URL=http://llama-embeddings:8080
LLAMA_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
# The backend adds a separator space if the prefix does not end with one.
QUERY_PROMPT_PREFIX=task: search result | query:

RECONCILIATION_ENABLED=true
RECONCILIATION_ON_STARTUP=true
RECONCILIATION_INTERVAL_SECONDS=120
RECONCILIATION_RETRY_FAILED=false
INGEST_BATCH_SIZE=1
SEARCH_DEFAULT_TOP_K=12
SEARCH_MAX_TOP_K=50

# ---------------------------------------------------------------------------
# Streamlit frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=8501
# Server-side URL used by Streamlit to call the backend. In compose this is the
# internal service name, not a loopback address.
API_BASE_URL=http://backend:8000
# Browser-visible URL used to resolve relative imageUrl values returned by the
# backend. Keep 127.0.0.1 for a local browser; replace it with the host/IP that
# the browser can reach when Streamlit is opened from another machine.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=30
API_SEARCH_TIMEOUT_SECONDS=90
FRONTEND_POLL_INTERVAL_SECONDS=3
FRONTEND_MAX_AUTO_POLLS=150
