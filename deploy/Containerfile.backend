# Python FastAPI backend: SSE consumer, ingestion, Milvus Lite, search API.
#
# Build context: backend/ (see deploy/compose.yaml)
# Expected layout (docs/rencana-implementasi.md):
#   backend/pyproject.toml
#   backend/app/main.py
#   backend/uv.lock (optional but recommended)
#
# Dependencies are installed with uv. The final image contains only the
# virtualenv and backend/app, not build caches or a host .venv.

ARG PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.5

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /src
# The full context is copied in the throwaway build stage so an existing
# uv.lock is used when present. Any host .venv is removed before syncing.
COPY . ./
RUN rm -rf .venv \
    && uv sync --no-dev --no-install-project

FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:${PATH}"

# Milvus Lite links against the GNU OpenMP runtime, which python:slim omits.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app /data \
    && chown -R 10001:10001 /app /data

WORKDIR /app

COPY --from=build --chown=10001:10001 /opt/venv /app/.venv
COPY --from=build --chown=10001:10001 /src/app /app/app

USER 10001:10001
EXPOSE 8000

# A single worker is deliberate: ingestion deduplication is in-memory and
# Milvus Lite is embedded in this process.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
