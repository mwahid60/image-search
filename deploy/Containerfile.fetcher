# Java Spring Boot image fetcher.
#
# Build context: fetcher/ (see deploy/compose.yaml)
# Expected layout (docs/rencana-implementasi.md):
#   fetcher/pom.xml
#   fetcher/src/...
#
# The final image contains only the built jar and a JRE.

ARG MAVEN_IMAGE=docker.io/library/maven:3.9.11-eclipse-temurin-21
ARG JRE_IMAGE=docker.io/library/eclipse-temurin:21-jre-jammy

FROM ${MAVEN_IMAGE} AS build

WORKDIR /workspace

# Build the runnable jar. The final stage only carries that jar and a JRE.
COPY pom.xml ./
COPY src ./src
RUN mvn -B -ntp -Dmaven.test.skip=true package \
    && find target -maxdepth 1 -type f -name '*.jar' \
         ! -name '*.original' \
         ! -name '*-sources.jar' \
         ! -name '*-javadoc.jar' \
         -exec cp {} /workspace/application.jar \;

FROM ${JRE_IMAGE}

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/application.jar /app/application.jar

USER 10001:10001
EXPOSE 8081

# JAVA_TOOL_OPTIONS is supplied by compose. Keep a conservative default for
# running the image directly.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC"

ENTRYPOINT ["java", "-jar", "/app/application.jar"]
