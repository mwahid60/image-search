# Streamlit frontend with two pages: Fetch Images and Search.
#
# Build context: frontend/ (see deploy/compose.yaml)
# Expected layout (docs/rencana-implementasi.md and frontend/README.md):
#   frontend/app.py
#   frontend/image_search/views/fetch_images.py
#   frontend/image_search/views/search.py
#   frontend/pyproject.toml
#
# Dependencies are installed with uv. The final image contains only the
# virtualenv, app.py, and views/.

ARG PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.5

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /src
COPY . ./
RUN rm -rf .venv \
    && uv sync --no-dev --no-install-project

FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:${PATH}"

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app \
    && chown -R 10001:10001 /app

WORKDIR /app

COPY --from=build --chown=10001:10001 /opt/venv /app/.venv
COPY --from=build --chown=10001:10001 /src/app.py /app/app.py
COPY --from=build --chown=10001:10001 /src/image_search /app/image_search

USER 10001:10001
EXPOSE 8501

CMD ["/app/.venv/bin/python", "-m", "streamlit", "run", "app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
