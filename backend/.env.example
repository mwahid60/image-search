APP_NAME=bank-mas-image-search-backend
LOG_LEVEL=INFO

# Java fetcher + SSE
JAVA_BASE_URL=http://localhost:8081
JAVA_EVENTS_PATH=/api/v1/events/fetch
SSE_ENABLED=true

# MinIO (credentials required; never commit real values)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=bank-mas
MINIO_POOL_MAXSIZE=32
IMAGE_PREFIX=images/bank-mas/
JOBS_PREFIX=jobs/bank-mas/

# llama.cpp embeddings server (EmbeddingGemma 2 + mmproj)
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_RETRY_INITIAL_SECONDS=1
EMBEDDING_RETRY_MAX_SECONDS=15
QUERY_PROMPT_PREFIX=task: search result | query:

# Milvus Lite database file. Do not use MILVUS_URI for Lite: pymilvus reserves
# MILVUS_URI for http(s) server URIs.
MILVUS_DB_PATH=data/milvus.db
MILVUS_COLLECTION=image_embeddings
# Only needed when connecting to a Milvus server that requires authentication.
# MILVUS_TOKEN=

# Ingestion guards
INGEST_MAX_IMAGE_PIXELS=25000000
INGEST_EMBEDDING_MAX_DIMENSION=1024

# Reconciliation fallback
RECONCILIATION_ENABLED=true
RECONCILIATION_ON_STARTUP=true
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_RETRY_FAILED=false
RECONCILIATION_MAX_ATTEMPTS=3
