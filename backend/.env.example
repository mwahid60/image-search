APP_NAME=bank-mas-image-search-backend
LOG_LEVEL=INFO

# Java fetcher + SSE
JAVA_BASE_URL=http://localhost:8080
JAVA_EVENTS_PATH=/api/v1/events/fetch
SSE_ENABLED=true

# MinIO (credentials required; never commit real values)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=bank-mas
IMAGE_PREFIX=images/bank-mas/
JOBS_PREFIX=jobs/bank-mas/

# llama.cpp embeddings server (EmbeddingGemma 2 + mmproj)
LLAMA_BASE_URL=http://localhost:8081
LLAMA_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
QUERY_PROMPT_PREFIX=task: search result | query:

# Milvus Lite
MILVUS_URI=data/milvus.db
MILVUS_COLLECTION=image_embeddings

# Reconciliation fallback
RECONCILIATION_ENABLED=true
RECONCILIATION_ON_STARTUP=true
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_RETRY_FAILED=false
