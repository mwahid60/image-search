%% Dua flow berdampingan dengan cabang ke service dan storage.
%% Edge luar Python Services mengarah ke grup agar arah internal tetap LR.
flowchart LR
    subgraph FETCH["A. FETCHING DAN INGESTION"]
        direction TB

        U1["User / Reviewer"]
        ST1["Streamlit Fetch Images<br/>kelas + jumlah gambar"]
        JAVA["Java Spring Boot Fetcher<br/>job background + download<br/>validasi + deduplikasi"]
        OV["Openverse API<br/>search + pagination"]
        DB1[("MinIO<br/>gambar + manifest<br/>ingestion status")]
        MODEL1["llama.cpp<br/>EmbeddingGemma 2 + mmproj<br/>image embedding"]
        VECTOR1[("Milvus<br/>vector 768d + metadata<br/>idempotent upsert")]
        RECON["Reconciliation<br/>startup + berkala"]

        subgraph PYTHON1["Python Services<br/>satu backend FastAPI"]
            direction LR
            API1["Python API Service<br/>POST fetch-jobs + polling status"]
            PY["Python Ingestion Pipeline<br/>SSE + queue + validasi + resize"]
            API1 -->|"enqueue jobId"| PY
        end

        U1 -->|"Fetch Images"| ST1
        ST1 -->|"kelas + jumlah"| PYTHON1
        PYTHON1 -->|"POST fetch job"| JAVA
        JAVA -->|"search + download"| OV
        JAVA -->|"simpan gambar + manifest"| DB1
        JAVA -->|"SSE fetch.completed"| PYTHON1
        DB1 -->|"baca gambar + manifest"| PYTHON1
        RECON -.->|"fallback SSE terlewat"| PYTHON1
        PYTHON1 -->|"image bytes"| MODEL1
        MODEL1 -->|"image vector"| PYTHON1
        PYTHON1 -->|"L2 normalize + upsert"| VECTOR1
        PYTHON1 -->|"INDEXED / PARTIAL / FAILED"| DB1
        JAVA -.->|"runtime status"| PYTHON1
        DB1 -.->|"manifest + status"| PYTHON1
        PYTHON1 -.->|"fetchStatus + ingestionStatus"| ST1
    end

    subgraph SEARCH["B. ONLINE SEARCH"]
        direction TB

        U2["User / Reviewer"]
        ST2["Streamlit Search<br/>query + topK + image grid"]
        API2["Python SearchService<br/>FastAPI backend<br/>POST search + validasi"]
        MODEL2["llama.cpp<br/>EmbeddingGemma 2<br/>text embedding"]
        VECTOR2[("Milvus<br/>top-k cosine search")]
        IMAGE["Python Image Service<br/>FastAPI backend yang sama<br/>GET images/{imageId}"]
        DB2[("MinIO<br/>image storage")]
        NOTE["Tanpa Openverse / Java<br/>evaluation_metadata tidak dipakai"]

        U2 -->|"natural-language query"| ST2
        ST2 -->|"search request"| API2
        API2 -->|"text query"| MODEL2
        MODEL2 -->|"text vector + L2 normalize"| API2
        API2 -->|"top-k query"| VECTOR2
        VECTOR2 -->|"imageId + score + atribusi"| API2
        API2 -->|"search results + imageUrl"| ST2
        ST2 -->|"image grid"| U2
        ST2 -->|"request imageUrl"| IMAGE
        IMAGE -->|"cari objectKey"| VECTOR2
        IMAGE -->|"ambil gambar"| DB2
        DB2 -->|"image bytes"| IMAGE
        IMAGE -->|"image response"| ST2
        API2 ~~~ NOTE
    end

    FETCH ~~~ SEARCH

    classDef fetchNode fill:#EFE9FB,stroke:#7C5CBF,stroke-width:1.5px,color:#2B1B4A;
    classDef searchNode fill:#E4F5EC,stroke:#3F8A64,stroke-width:1.5px,color:#133326;
    classDef storageNode fill:#FFF4D6,stroke:#B08927,stroke-width:1.5px,color:#3A2C08;
    classDef modelNode fill:#DCF0D8,stroke:#4C7F3F,stroke-width:1.5px,color:#1B3016;
    classDef noteNode fill:#F4F4F6,stroke:#8A8A93,stroke-width:1px,color:#33333A;

    class U1,ST1,API1,JAVA,PY,RECON fetchNode;
    class U2,ST2,API2,IMAGE searchNode;
    class DB1,VECTOR1,DB2,VECTOR2 storageNode;
    class MODEL1,MODEL2 modelNode;
    class OV,NOTE noteNode;

    style PYTHON1 fill:#F8F4FF,stroke:#7C5CBF,stroke-width:2px,color:#2B1B4A;
